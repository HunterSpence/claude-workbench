{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "switchModelsOnFlag": false,
  "env": {
    "WORKBENCH_KB_ROOT": "{{KB_ROOT}}",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "GIT_TERMINAL_PROMPT": "0",
    "GCM_INTERACTIVE": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/rules/tokensave.md"
  ],
  "cleanupPeriodDays": 14,
  "autoUpdatesChannel": "stable",
  "respondToBashCommands": false,
  "tui": "default",
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} \"{{WORKBENCH_HOME}}/statusline.py\""
  }
}
