{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "showThinkingSummaries": true,
  "switchModelsOnFlag": false,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "WORKBENCH_KB_ROOT": "{{KB_ROOT}}",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "GIT_TERMINAL_PROMPT": "0",
    "GCM_INTERACTIVE": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "ENABLE_TOOL_SEARCH": "auto:1",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "MCP_TIMEOUT": "60000",
    "MSYS2_ARG_CONV_EXCL": "origin/;upstream/;refs/"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Bash(git * push *--force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push +*)",
      "PowerShell(git * push *--force*)",
      "PowerShell(git * push -f*)",
      "PowerShell(git * push * -f*)",
      "PowerShell(git * push * +*)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh release delete *)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/rules/tokensave.md"
  ],
  "cleanupPeriodDays": 14,
  "autoUpdatesChannel": "stable",
  "respondToBashCommands": false,
  "tui": "default",
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} \"{{WORKBENCH_HOME}}/statusline.py\""
  },
  "subagentPromptCacheTtl": "5m",
  "crossSessionInbound": "hold"
}
