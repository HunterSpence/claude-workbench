{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "showThinkingSummaries": true,
  "switchModelsOnFlag": false,
  "env": {
    "WORKBENCH_KB_ROOT": "{{KB_ROOT}}",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "GIT_TERMINAL_PROMPT": "0",
    "GCM_INTERACTIVE": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(gh gist create *)",
      "Bash(gh release create *)",
      "Bash(gh release upload *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn npm publish *)",
      "Bash(twine upload *)",
      "Bash(poetry publish *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)",
      "Bash(podman push *)",
      "Bash(gem push *)",
      "Bash(dotnet nuget push *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3 sync *)",
      "Bash(az storage blob upload *)",
      "Bash(gsutil cp *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue comment *)",
      "Bash(gcloud storage cp *)",
      "Bash(gcloud storage rsync *)",
      "Bash(gcloud storage mv *)",
      "Bash(aws s3 mv *)",
      "Bash(gsutil rsync *)",
      "Bash(gsutil mv *)",
      "Bash(docker image push *)",
      "Bash(podman image push *)",
      "Bash(yarn publish *)",
      "Bash(az storage blob upload-batch *)",
      "PowerShell(gh gist create *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh release upload *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(yarn npm publish *)",
      "PowerShell(twine upload *)",
      "PowerShell(poetry publish *)",
      "PowerShell(cargo publish *)",
      "PowerShell(docker push *)",
      "PowerShell(podman push *)",
      "PowerShell(gem push *)",
      "PowerShell(dotnet nuget push *)",
      "PowerShell(scp *)",
      "PowerShell(rsync *)",
      "PowerShell(sftp *)",
      "PowerShell(aws s3 cp *)",
      "PowerShell(aws s3 sync *)",
      "PowerShell(az storage blob upload *)",
      "PowerShell(gsutil cp *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gcloud storage cp *)",
      "PowerShell(gcloud storage rsync *)",
      "PowerShell(gcloud storage mv *)",
      "PowerShell(aws s3 mv *)",
      "PowerShell(gsutil rsync *)",
      "PowerShell(gsutil mv *)",
      "PowerShell(docker image push *)",
      "PowerShell(podman image push *)",
      "PowerShell(yarn publish *)",
      "PowerShell(az storage blob upload-batch *)",
      "PowerShell(Publish-Module *)",
      "PowerShell(Publish-Script *)",
      "PowerShell(Publish-PSResource *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/rules/tokensave.md"
  ],
  "cleanupPeriodDays": 14,
  "autoUpdatesChannel": "stable",
  "respondToBashCommands": false,
  "tui": "default",
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} \"{{WORKBENCH_HOME}}/statusline.py\""
  }
}
