{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "WORKBENCH_KB_ROOT": "{{KB_ROOT}}",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "GIT_TERMINAL_PROMPT": "0",
    "GCM_INTERACTIVE": "never",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "600",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "10",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "12",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "auto:1",
    "PONYTAIL_SUBAGENT_MATCHER": "^(none)$",
    "MCP_TIMEOUT": "60000",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "MSYS2_ARG_CONV_EXCL": "origin/;upstream/;refs/"
  },
  "attribution": {
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Read(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Bash(git * push *--force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push +*)",
      "PowerShell(git * push *--force*)",
      "PowerShell(git * push -f*)",
      "PowerShell(git * push * -f*)",
      "PowerShell(git * push * +*)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh release delete *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} \"{{WORKBENCH_HOME}}/statusline.py\""
  },
  "subagentPromptCacheTtl": "5m",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "claudeMdExcludes": [
    "**/rules/tokensave.md"
  ],
  "theme": "dark",
  "switchModelsOnFlag": false,
  "crossSessionInbound": "hold"
}
