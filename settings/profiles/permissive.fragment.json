  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "{{PYTHON}} \"{{WORKBENCH_HOME}}/statusline.py\""
  },
  "subagentPromptCacheTtl": "5m",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "claudeMdExcludes": [
    "**/rules/tokensave.md"
  ],
  "theme": "dark",
  "switchModelsOnFlag": false,
  "crossSessionInbound": "hold"
