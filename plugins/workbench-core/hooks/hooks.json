{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/ponytail_auto.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/ponytail_auto.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/auto_invoke.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|WebFetch|Agent|mcp__.*([Pp]laywright|[Cc]hrome|[Pp]uppeteer|[Bb]rowser).*|mcp__.*([Pp][Oo][Ss][Tt][Gg][Rr][Ee][Ss]|[Ss][Qq][Ll]|[Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee]).*|mcp__.*_(str_replace|multi_str_replace|insert_at|insert_at_symbol|replace_symbol|ast_grep_rewrite|replace_lines|delete_symbol)",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/guards/pretooluse.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/read_flood_guard.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/auto_invoke.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/checkpoint.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/ponytail_auto.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/bug_hint.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/precompact.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/cred_check.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|policy_settings",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/config_change_log.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/instructions_loaded.py"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
