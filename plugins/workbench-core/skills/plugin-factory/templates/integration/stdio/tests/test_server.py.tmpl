"""Protocol tests for the example server. Run from the repository root: python -m unittest discover -s plugins/__NAME__/tests -v"""
import json
import subprocess
import sys
import unittest
from pathlib import Path

SERVER = Path(__file__).resolve().parents[1] / "server" / "server.py"


def talk(*messages):
    """Send all messages, close stdin, return the replies by id."""
    data = "".join(json.dumps(m) + "\n" for m in messages)
    p = subprocess.run([sys.executable, "-I", str(SERVER)], input=data, capture_output=True, text=True, timeout=30)
    assert p.returncode == 0, p.stderr
    return {r["id"]: r for r in map(json.loads, filter(None, p.stdout.splitlines()))}


def rpc(i, method, params=None):
    return {"jsonrpc": "2.0", "id": i, "method": method, "params": params or {}}


INIT = rpc(1, "initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "test", "version": "0"}})
READY = {"jsonrpc": "2.0", "method": "notifications/initialized"}


class ServerTest(unittest.TestCase):
    def test_initialize_and_list_tools(self):
        r = talk(INIT, READY, rpc(2, "tools/list"))
        self.assertEqual(r[1]["result"]["serverInfo"]["name"], "__NAME__")
        tools = r[2]["result"]["tools"]
        self.assertGreaterEqual(len(tools), 1)
        for t in tools:
            self.assertTrue(t["title"] and t["description"])
            self.assertTrue({"readOnlyHint", "destructiveHint"} & set(t["annotations"]))

    def test_a_tool_call_round_trip(self):
        r = talk(INIT, READY, rpc(2, "tools/call", {"name": "add_item", "arguments": {"text": "first"}}),
                 rpc(3, "tools/call", {"name": "list_items"}))
        self.assertEqual(r[3]["result"]["content"][0]["text"], "first")

    def test_bad_arguments_are_a_tool_error_not_a_crash(self):
        r = talk(INIT, rpc(2, "tools/call", {"name": "add_item", "arguments": {"text": ""}}))
        self.assertTrue(r[2]["result"]["isError"])
        self.assertIn("non-empty", r[2]["result"]["content"][0]["text"])

    def test_unknown_tool_and_method_are_protocol_errors(self):
        r = talk(INIT, rpc(2, "tools/call", {"name": "nope"}), rpc(3, "resources/list"))
        self.assertEqual(r[2]["error"]["code"], -32602)
        self.assertEqual(r[3]["error"]["code"], -32601)


if __name__ == "__main__":
    unittest.main()
